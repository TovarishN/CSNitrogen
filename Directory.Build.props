<Project><PropertyGroup>
<TargetFramework>net10.0</TargetFramework><LangVersion>14</LangVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
<NitrogenRoot Condition="'$(NitrogenRoot)' == ''">$(MSBuildThisFileDirectory).dependencies/Nitrogen</NitrogenRoot>
</PropertyGroup></Project>
