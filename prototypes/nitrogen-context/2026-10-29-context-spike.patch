--- /dev/null
+++ b/Nitrogen.Runtime/ParserState.ContextSpike.cs
@@ -0,0 +1,13 @@
+// THROWAWAY internal experiment. Not a supported API or generated grammar feature.
+namespace Nitrogen;
+public unsafe ref partial struct ParserState
+{
+    internal bool InGrammarContext(ulong mask, ulong values, delegate*<ref ParserState, bool> parse)
+    {
+        if ((values & ~mask) != 0) throw new ArgumentOutOfRangeException(nameof(values));
+        ulong previous = GrammarContext;
+        GrammarContext = (previous & ~mask) | values;
+        try { return parse(ref this); }
+        finally { GrammarContext = previous; }
+    }
+}
