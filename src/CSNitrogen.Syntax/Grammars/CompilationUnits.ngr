syntax module CSharp.CompilationUnits
{
 syntax UsingDirective = "using" Alias:(CSharp.Lexical.Identifier "=")? Name:CSharp.NamesTypes.QualifiedName ";";
 syntax NamespaceDeclaration = "namespace" Name:CSharp.NamesTypes.QualifiedName "{" Usings:UsingDirective* Members:NamespaceMember* "}" ";"?;
 extensible syntax NamespaceMember { | NamespaceMemberBody = Value:(NamespaceDeclaration / CSharp.Declarations.TypeDeclaration) }
 syntax CompilationUnit = Usings:UsingDirective* Attributes:CSharp.Attributes.GlobalAttributeSection* Members:NamespaceMember*;
}
