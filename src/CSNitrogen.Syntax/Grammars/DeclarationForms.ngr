syntax module CSharp.DeclarationForms
{
 extend syntax CSharp.Declarations.Modifier { | PartialModifier = CSharp.Lexical.ContextualPartial }
 extend syntax CSharp.Declarations.AccessorModifiers
 {
  | AccessorAccessibility = Value:("protected" "internal"? / "internal" "protected"? / "private")
 }
}
