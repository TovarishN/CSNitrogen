syntax module Probe.CSharp5AsyncFunctions
{
 token AsyncKeyword = CSharp.Lexical.Contextual("async");
 extend syntax CSharp.Declarations.Modifier
 {
  | AsyncModifier = Keyword:AsyncKeyword &(CSharp.Declarations.Modifier* CSharp.Declarations.MethodDeclaration)
 }
 extend syntax CSharp.AnonymousMethods.AsyncMarker
 {
  | AsyncFunction = Keyword:AsyncKeyword &("delegate" / (CSharp.Lambdas.LambdaSignature "=>"))
 }
}
