language CSharp2SeamBase { start Probe.CSharp2Seam.Header; namespace CSNitrogen.Tests.Probes; }
syntax module Probe.CSharp2Seam
{
 token Identifier = ['a'..'z' 'A'..'Z' '_'] ['a'..'z' 'A'..'Z' '_' '0'..'9']*;
 syntax QualifiedName = Parts:(Identifier; ".")+;
 extensible syntax TypeParameters { }
 syntax Header = "class" Name:Identifier Parameters:TypeParameters? "{" "}";
}
